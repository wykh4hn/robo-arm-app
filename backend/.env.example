# Copy to .env (never commit .env). See docs/communication-plan.md for every decision.
SO101_BE_HOST=0.0.0.0
SO101_BE_PORT=8001

# LIBERO sim, Operator API (franka_ee_v1). The BE never talks to the Board directly.
# Dev and tests: the real sim in fake mode, `python server.py --backend fake`.
SO101_SIM_URL=http://127.0.0.1:8000
SO101_OPERATOR_TOKEN_FILE=../libero_board/runtime/.operator-token
SO101_SIM_POLL_HZ=10
SO101_SIM_TIMEOUT_MS=2000
SO101_SIM_POLL_TIMEOUT_MS=500
# RESET takes 3-15 s on the Board. Also the HTTP timeout of STOP: a stop sent during a
# reset waits for it to finish (Q5).
SO101_LIBERO_RESET_TIMEOUT_MS=30000

# Q2: demo tasks ("suite:task_id", comma separated), first one is the default.
SO101_LIBERO_TASKS=libero_spatial:0,libero_object:0
# Task a REST reset uses when its body names none.
SO101_LIBERO_SUITE=libero_spatial
SO101_LIBERO_TASK_ID=0
SO101_LIBERO_INIT_STATE=0

# Q1: the Board runner has no "wait for command" mode yet. true = Send needs
# session_active. false (dev only) = the BE resets anyway; start the runner with
# --no-reset by hand.
SO101_REQUIRE_BOARD_SESSION=true

SO101_DATA_DIR=./data
SO101_MODE=dev
SO101_EVIDENCE_CLASS=laptop
# Only for the Vite dev server: the page served by the BE on 8001 is always allowed,
# whether opened as localhost, 127.0.0.1 or the laptop's LAN IP (iPad).
SO101_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SO101_CAMERA_PREVIEW=true
SO101_CAMERA_FPS=10
