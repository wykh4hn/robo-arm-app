# Copy to .env (never commit .env). Timings are provisional until contract SO101-37 (spec Q11).
SO101_BE_HOST=0.0.0.0
SO101_BE_PORT=8001

# MuJoCo (path 5). "mock" = the fake simulator inside the BE; "real" = app/sim_client.py (Phase 2).
SO101_SIM_LINK=mock
SO101_SIM_URL=http://127.0.0.1:8000
SO101_SIM_POLL_HZ=10
SO101_SIM_TIMEOUT_MS=2000
SO101_SIM_POLL_TIMEOUT_MS=500

# Board (path 2). "mock" = the fake board inside the BE; "real" = app/board_link.py (Phase 3, Q1).
SO101_BOARD_LINK=mock
SO101_BOARD_TIMEOUT_MS=2000

SO101_DATA_DIR=./data
SO101_MODE=dev
SO101_EVIDENCE_CLASS=laptop
# Only for the Vite dev server: the page served by the BE on 8001 is always allowed,
# whether opened as localhost, 127.0.0.1 or the laptop's LAN IP (iPad).
SO101_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SO101_TELEMETRY_STALE_MS=1500
SO101_PREPARE_TIMEOUT_S=120
SO101_RUN_WALL_TIMEOUT_S=300
SO101_TELEMETRY_WEB_HZ=10
SO101_CAMERA_PREVIEW=true
SO101_CAMERA_FPS=10
# Gripper range in rad (Q6). Empty = the FE gripperMap (-0.17 closed, 1.6 open).
SO101_GRIPPER_CLOSED_RAD=
SO101_GRIPPER_OPEN_RAD=

# Fake simulator (only with SO101_SIM_LINK=mock). See tools/mock_sim.py for every scenario.
MOCK_SIM_SCENARIO=normal
MOCK_SIM_EPISODE_S=8
MOCK_BOARD_SCENARIO=ok
