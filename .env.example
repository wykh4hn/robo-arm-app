# --- Frontend (Vite reads this file as .env / .env.local at the repo root) ---
# Backend WebSocket URL, only for `npm run dev` on port 5173. Leave it empty to keep
# the in-browser mock (UI dev and tests only). A build served by the backend on
# port 8001 needs nothing here: it connects to the same host that served the page.
VITE_BACKEND_URL=ws://localhost:8001/ws

# --- Backend (copy these into backend/.env; the BE reads .env from its own folder) ---
# Full list with comments: backend/.env.example. The BE talks only to the LIBERO
# Operator API over HTTP (docs/communication-plan.md §1); it has no link to the Board.
SO101_BE_HOST=0.0.0.0
SO101_BE_PORT=8001
SO101_SIM_URL=http://127.0.0.1:8000
SO101_OPERATOR_TOKEN_FILE=../libero_board/runtime/.operator-token
# Q2: demo tasks, first one is the default.
SO101_LIBERO_TASKS=libero_spatial:0,libero_object:0
SO101_LIBERO_SUITE=libero_spatial
SO101_LIBERO_TASK_ID=0
SO101_LIBERO_INIT_STATE=0
# Q1: true = Send needs a Board session. false (dev only) = the BE resets anyway and the
# operator starts the runner with --no-reset by hand.
SO101_REQUIRE_BOARD_SESSION=true
SO101_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8001,http://<IP laptop>:8001
